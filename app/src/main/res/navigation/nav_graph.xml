<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!--  主页  -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.lyxiiin.flownote.ui.home.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_home_to_note_category_detail"
            app:destination="@+id/noteCategoryDetailFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false"/>
        <action
            android:id="@+id/action_home_to_note_detail"
            app:destination="@+id/noteDetailFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false"/>
        <action
            android:id="@+id/action_home_to_note_move"
            app:destination="@+id/noteMoveFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false"/>
        <action
            android:id="@+id/action_home_to_todo_edit"
            app:destination="@+id/todoEditFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false"/>
        <action
            android:id="@+id/action_home_to_profile"
            app:destination="@+id/profileFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false"/>
    </fragment>

    <!--  分组详情页  -->
    <fragment
        android:id="@+id/noteCategoryDetailFragment"
        android:name="com.lyxiiin.flownote.ui.category.NoteCategoryDetailFragment"
        android:label="NoteCategoryDetail">
        <argument
            android:name="categoryId"
            app:argType="long"
            android:defaultValue="-1L" />
        <action
            android:id="@+id/action_note_Category_to_note_Detail"
            app:destination="@+id/noteDetailFragment"
            app:popUpTo="@id/noteCategoryDetailFragment"
            app:popUpToInclusive="false"/>
        <action
            android:id="@+id/action_note_category_detail_to_note_move"
            app:destination="@+id/noteMoveFragment"
            app:popUpTo="@id/noteCategoryDetailFragment"
            app:popUpToInclusive="false"/>
    </fragment>

    <!--  笔记详情页  -->
    <fragment
        android:id="@+id/noteDetailFragment"
        android:name="com.lyxiiin.flownote.ui.note.NoteDetailFragment"
        android:label="NoteDetail">
        <argument
            android:name="noteId"
            app:argType="long"
            android:defaultValue="-1L" />
        <argument
            android:name="categoryId"
            app:argType="long"
            android:defaultValue="-1L" />
        <action
            android:id="@+id/action_note_detail_to_note_move"
            app:destination="@+id/noteMoveFragment"
            app:popUpTo="@id/noteDetailFragment"
            app:popUpToInclusive="false"/>
    </fragment>

    <!--  移动笔记页  -->
    <fragment
        android:id="@+id/noteMoveFragment"
        android:name="com.lyxiiin.flownote.ui.move.NoteMoveFragment"
        android:label="NoteMove">
        <argument
            android:name="noteId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <!--  启动页  -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.lyxiiin.flownote.ui.splash.SplashFragment"
        android:label="Splash">
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@+id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <!--  待办编辑页  -->
    <fragment
        android:id="@+id/todoEditFragment"
        android:name="com.lyxiiin.flownote.ui.todo.TodoEditFragment"
        android:label="TodoEdit">
        <argument
            android:name="todoId"
            app:argType="long"
            android:defaultValue="-1L"/>
    </fragment>

    <!--  设置页  -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.lyxiiin.flownote.ui.profile.ProfileFragment"
        android:label="Profile">
        <action
            android:id="@+id/action_profile_to_language"
            app:destination="@+id/languageFragment"
            app:popUpTo="@id/profileFragment"
            app:popUpToInclusive="false"/>
        <action
            android:id="@+id/action_profile_to_appearance"
            app:destination="@+id/appearanceFragment"
            app:popUpTo="@id/profileFragment"
            app:popUpToInclusive="false"/>
        <action
            android:id="@+id/action_profile_to_about"
            app:destination="@+id/aboutFragment"
            app:popUpTo="@id/profileFragment"
            app:popUpToInclusive="false"/>
    </fragment>

    <fragment
        android:id="@+id/languageFragment"
        android:name="com.lyxiiin.flownote.ui.profile.LanguageFragment"
        android:label="Language">

    </fragment>

    <fragment
        android:id="@+id/appearanceFragment"
        android:name="com.lyxiiin.flownote.ui.profile.AppearanceFragment"
        android:label="Appearance">

    </fragment>

    <!--  关于页  -->
    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.lyxiiin.flownote.ui.profile.AboutFragment"
        android:label="About">

    </fragment>

</navigation>